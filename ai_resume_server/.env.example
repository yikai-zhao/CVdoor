# 环境变量示例 — 复制为 .env 并填入真实值（不要提交 .env 到 git）
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
DEBUG=0
DB_PATH=cvdoor.db
CORS_ALLOWED_ORIGINS=https://cvdoor.app,https://www.cvdoor.app
SERVER_API_KEY=replace_with_strong_server_key
SESSION_TOKEN_SECRET=replace_with_random_secret
SESSION_TOKEN_TTL_SEC=86400
MIN_COVER_LETTER_QUALITY_SCORE=75
